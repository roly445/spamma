@page "/admin/catch-all-senders"
@layout AppLayout
@attribute [Authorize]

<PageTitle>Catch-All Sender Addresses - Spamma</PageTitle>

<AdminHeader Title="Catch-All Sender Addresses" Subtitle="Manage whitelisted sender addresses for catch-all email routing">
    <Controls>
        <button type="button" @onclick="OpenAddModal"
                class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add Address
        </button>
    </Controls>
</AdminHeader>

<div class="min-h-screen bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

        @if (_isLoading)
        {
            <div class="flex items-center justify-center p-16">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-amber-600"></div>
            </div>
        }
        else
        {
            <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
                @if (_items.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center p-16 text-center">
                        <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mb-4">
                            <svg class="w-8 h-8 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">No sender addresses yet</h3>
                        <p class="text-sm text-gray-500 max-w-md">
                            Catch-all sender addresses let you route emails from specific senders to assigned users.
                            Add a sender address to get started.
                        </p>
                    </div>
                }
                else
                {
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Sender Address
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Assigned Users
                                </th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Added
                                </th>
                                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var item in _items)
                            {
                                <tr class="@GetRowClasses(item)" @onclick="() => !item.IsRemoved ? HandleSelectRow(item.Id) : Task.CompletedTask">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center space-x-3">
                                            <div class="w-8 h-8 bg-amber-100 rounded-full flex items-center justify-center flex-shrink-0">
                                                <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                                </svg>
                                            </div>
                                            <span class="text-sm font-medium text-gray-900 @(item.IsRemoved ? "line-through" : "")">
                                                @item.SenderAddress
                                            </span>
                                            @if (item.IsRemoved)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">
                                                    Removed
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                            @item.AssignedUserCount user@(item.AssignedUserCount != 1 ? "s" : "")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        @item.AddedAt.ToString("MMM d, yyyy")
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        @if (!item.IsRemoved)
                                        {
                                            <button type="button"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => HandleRemove(item.Id)"
                                                    class="text-red-600 hover:text-red-800 text-sm font-medium">
                                                Remove
                                            </button>
                                        }
                                    </td>
                                </tr>

                                @if (_selectedItemId == item.Id)
                                {
                                    <tr>
                                        <td colspan="4" class="px-6 py-4 bg-amber-50 border-t border-amber-100">
                                            <div class="flex items-start space-x-3">
                                                <svg class="w-5 h-5 text-amber-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                </svg>
                                                <div class="flex-1">
                                                    <h4 class="text-sm font-medium text-amber-900 mb-2">Assigned Users</h4>
                                                    @if (_isLoadingDetail)
                                                    {
                                                        <div class="flex items-center space-x-2">
                                                            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-amber-600"></div>
                                                            <span class="text-sm text-amber-700">Loading...</span>
                                                        </div>
                                                    }
                                                    else if (_selectedDetail == null || _selectedDetail.AssignedUserIds.Count == 0)
                                                    {
                                                        <p class="text-sm text-amber-700">No users assigned to this sender address.</p>
                                                    }
                                                    else
                                                    {
                                                        <ul class="space-y-2">
                                                            @foreach (var userId in _selectedDetail.AssignedUserIds)
                                                            {
                                                                <li class="flex items-center justify-between bg-white border border-amber-200 rounded-md px-3 py-2 max-w-md">
                                                                    <div class="flex items-center space-x-2">
                                                                        <div class="w-6 h-6 bg-amber-200 rounded-full flex items-center justify-center">
                                                                            <svg class="w-3 h-3 text-amber-700" fill="currentColor" viewBox="0 0 24 24">
                                                                                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
                                                                            </svg>
                                                                        </div>
                                                                        <span class="text-xs font-mono text-gray-600">@userId</span>
                                                                    </div>
                                                                    <button type="button"
                                                                            @onclick="() => HandleUnassignUser(userId)"
                                                                            class="ml-4 text-xs text-red-600 hover:text-red-800 font-medium">
                                                                        Unassign
                                                                    </button>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>
</div>

@if (_showAddModal)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @onclick="CloseAddModal">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4" @onclick:stopPropagation="true">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-amber-100 rounded-md flex items-center justify-center mr-3">
                        <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                    </div>
                    <h2 class="text-lg font-medium text-gray-900">Add Sender Address</h2>
                </div>
            </div>

            <div class="px-6 py-5">
                <p class="text-sm text-gray-500 mb-4">
                    Enter the sender email address to whitelist for catch-all routing.
                </p>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="new-sender-address">
                        Sender Address
                    </label>
                    <input id="new-sender-address"
                           type="email"
                           @bind="_newSenderAddress"
                           @bind:event="oninput"
                           placeholder="sender@example.com"
                           class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 @(_addError != null ? "border-red-300" : "")" />
                    @if (_addError != null)
                    {
                        <p class="mt-1 text-sm text-red-600">@_addError</p>
                    }
                </div>
            </div>

            <div class="px-6 py-3 border-t border-gray-200 bg-gray-50 flex justify-end space-x-3 rounded-b-lg">
                <button type="button" @onclick="CloseAddModal"
                        class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500">
                    Cancel
                </button>
                <button type="button" @onclick="HandleAddAddress"
                        class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500">
                    Add
                </button>
            </div>
        </div>
    </div>
}
