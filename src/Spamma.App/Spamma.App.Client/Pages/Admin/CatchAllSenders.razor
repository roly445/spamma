@page "/admin/catch-all-senders"
@layout AppLayout
@attribute [Authorize]

<PageTitle>Catch-All Sender Addresses - Spamma</PageTitle>

<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <AdminHeader Title="Catch-All Sender Addresses" Subtitle="Manage whitelisted sender addresses for catch-all email routing">
        <Controls>
            <button type="button" @onclick="OpenAddModal"
                    class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add Address
            </button>
        </Controls>
    </AdminHeader>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Search -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="md:col-span-3">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Search</label>
                    <input type="text"
                           @bind-value="_searchTerm"
                           @bind-value:event="oninput"
                           placeholder="Search by sender address..."
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                </div>
            </div>
        </div>

        <!-- Sender Addresses Table -->
        <div class="bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Sender addresses</h3>
            </div>

            @if (_isLoading)
            {
                <div class="flex items-center justify-center py-12">
                    <svg class="animate-spin h-8 w-8 text-blue-600 fill-none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
            }
            else if (FilteredItems.Any())
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sender Address</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assigned Users</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Added</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var item in FilteredItems)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center space-x-3">
                                            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                                                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                                </svg>
                                            </div>
                                            <span class="text-sm font-medium text-gray-900 @(item.IsRemoved ? "line-through" : "")">
                                                @item.SenderAddress
                                            </span>
                                            @if (item.IsRemoved)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">
                                                    Removed
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            @item.AssignedUserCount user@(item.AssignedUserCount != 1 ? "s" : "")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        @item.AddedAt.ToString("MMM d, yyyy")
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        @if (!item.IsRemoved)
                                        {
                                            <div class="flex items-center justify-end space-x-2">
                                                <button @onclick="() => OpenManageModal(item.Id)" class="text-blue-600 hover:text-blue-900">Manage</button>
                                                <button @onclick="() => HandleRemove(item.Id)" class="text-red-600 hover:text-red-900">Remove</button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-12">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">No sender addresses found</h3>
                    <p class="mt-1 text-sm text-gray-500">@(string.IsNullOrEmpty(_searchTerm) ? "Add a sender address to get started." : "Try adjusting your search.")</p>
                </div>
            }
        </div>
    </div>
</div>

@if (_showAddModal)
{
    <ModalBase IsVisible="@_showAddModal" OnClose="CloseAddModal" AllowBackdropClose="true" WidthClass="@ModalBase.ModalSizes.Medium" AriaLabelledBy="addSenderModalLabel">
        <div class="max-h-screen overflow-y-auto" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <h3 id="addSenderModalLabel" class="text-lg font-medium text-gray-900">Add Sender Address</h3>
                    <button @onclick="CloseAddModal" class="text-gray-400 hover:text-gray-500 focus:outline-none focus:text-gray-500">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="px-6 py-5">
                <p class="text-sm text-gray-500 mb-4">
                    Enter the sender email address to whitelist for catch-all routing.
                </p>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="new-sender-address">
                        Sender Address
                    </label>
                    <input id="new-sender-address"
                           type="email"
                           @bind="_newSenderAddress"
                           @bind:event="oninput"
                           placeholder="sender@example.com"
                           class="block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 @(_addError != null ? "border-red-300" : "")" />
                    @if (_addError != null)
                    {
                        <p class="mt-1 text-sm text-red-600">@_addError</p>
                    }
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="mt-6 flex justify-end space-x-3 px-6 pb-6">
                <button type="button" @onclick="CloseAddModal"
                        class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Cancel
                </button>
                <button type="button" @onclick="HandleAddAddress"
                        class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Add Address
                </button>
            </div>
        </div>
    </ModalBase>
}

<!-- Manage Sender Address Slide-out Panel -->
@if (_showManageModal)
{
    <SlideoutBase IsVisible="@_showManageModal" OnClose="CloseManageModal" AllowBackdropClose="true" WidthClass="max-w-md" AriaLabelledBy="manageSenderPanelLabel">
        <!-- Header -->
        <div class="px-4 sm:px-6 py-6 border-b border-gray-200">
            <div class="flex items-start justify-between">
                <div>
                    <h2 id="manageSenderPanelLabel" class="text-lg font-medium text-gray-900">Manage Sender Address</h2>
                    @if (_managingDetail != null)
                    {
                        <p class="mt-1 text-sm text-gray-500">@_managingDetail.SenderAddress</p>
                    }
                </div>
                <button @onclick="CloseManageModal" class="ml-3 rounded-md text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Content -->
        <div class="flex-1 px-4 sm:px-6 py-6">
            @if (_isLoadingManageDetail || _managingDetail == null)
            {
                <div class="flex items-center justify-center py-12">
                    <svg class="animate-spin h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
            }
            else
            {
                <div class="space-y-6">
                    <!-- Assigned Users -->
                    <div>
                        <h4 class="text-sm font-medium text-gray-900 mb-3">Assigned users</h4>
                        @if (_managingDetail.AssignedUserIds.Count == 0)
                        {
                            <p class="text-sm text-gray-500">No users assigned yet.</p>
                        }
                        else
                        {
                            <ul class="divide-y divide-gray-200 border border-gray-200 rounded-md">
                                @foreach (var userId in _managingDetail.AssignedUserIds)
                                {
                                    <li class="flex items-center justify-between px-4 py-3">
                                        <div class="flex items-center space-x-3">
                                            <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
                                                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                </svg>
                                            </div>
                                            <span class="text-sm text-gray-700">
                                                @(_assignedUserEmails.TryGetValue(userId, out var email) ? email : userId.ToString())
                                            </span>
                                        </div>
                                        <button @onclick="() => HandleUnassignUser(userId)"
                                                class="text-red-600 hover:text-red-900 text-sm font-medium">
                                            Unassign
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <!-- Assign User -->
                    <div>
                        <h4 class="text-sm font-medium text-gray-900 mb-3">Assign user</h4>
                        <div class="flex space-x-2">
                            <input type="text"
                                   @bind="_assignSearchTerm"
                                   @bind:event="oninput"
                                   placeholder="Search by email or name..."
                                   class="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                            <button type="button" @onclick="HandleUserSearch"
                                    disabled="@_isSearchingUsers"
                                    class="px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50">
                                Search
                            </button>
                        </div>

                        @if (_isSearchingUsers)
                        {
                            <div class="flex items-center space-x-2 mt-3">
                                <svg class="animate-spin h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span class="text-sm text-gray-500">Searching...</span>
                            </div>
                        }
                        else if (_assignSearchResults.Count > 0)
                        {
                            <ul class="mt-2 divide-y divide-gray-200 border border-gray-200 rounded-md">
                                @foreach (var user in _assignSearchResults)
                                {
                                    var alreadyAssigned = _managingDetail.AssignedUserIds.Contains(user.Id);
                                    <li class="flex items-center justify-between px-4 py-3">
                                        <div>
                                            <p class="text-sm font-medium text-gray-900">@(user.DisplayName ?? user.Email)</p>
                                            <p class="text-xs text-gray-500">@user.Email</p>
                                        </div>
                                        @if (alreadyAssigned)
                                        {
                                            <span class="text-xs text-gray-400">Already assigned</span>
                                        }
                                        else
                                        {
                                            <button @onclick="() => HandleAssignUser(user.Id)"
                                                    class="text-blue-600 hover:text-blue-900 text-sm font-medium">
                                                Assign
                                            </button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else if (!string.IsNullOrEmpty(_assignSearchTerm) && !_isSearchingUsers)
                        {
                            <p class="text-sm text-gray-500 mt-3">No users found.</p>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Footer -->
        <div class="flex-shrink-0 px-4 sm:px-6 py-4 border-t border-gray-200 bg-gray-50">
            <div class="flex justify-end">
                <button type="button" @onclick="CloseManageModal"
                        class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Close
                </button>
            </div>
        </div>
    </SlideoutBase>
}
