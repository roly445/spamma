@page "/admin/settings"
@layout AppLayout
@attribute [Authorize]

<PageTitle>Settings - Spamma</PageTitle>

<AdminHeader Title="Settings" Subtitle="Configure global application settings"></AdminHeader>

<div class="min-h-screen bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- Catch-All Mode Card -->
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm mb-6">
            <div class="px-6 py-5 border-b border-gray-200">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-amber-100 rounded-md flex items-center justify-center mr-3">
                        <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-lg font-medium text-gray-900">Catch-All Mode</h2>
                        <p class="text-sm text-gray-500">Capture emails sent to any address on this server</p>
                    </div>
                </div>
            </div>

            <div class="px-6 py-5">
                <!-- Warning Banner -->
                <div class="bg-amber-50 border border-amber-200 rounded-md p-4 mb-6">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.966-.833-2.736 0L3.077 16.5c-.77.833.192 2.5 1.732 2.5z" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-amber-800">Use with care</h3>
                            <p class="mt-1 text-sm text-amber-700">
                                When enabled, all incoming emails will be captured regardless of domain. This includes emails to unregistered domains. Not recommended for production use.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Toggle -->
                <div class="flex items-center justify-between py-4 border border-gray-200 rounded-lg px-5">
                    <div>
                        <p class="text-sm font-medium text-gray-900">Enable Catch-All Mode</p>
                        <p class="text-sm text-gray-500 mt-0.5">Accept emails for any recipient address, grouped in a separate Catch-All Inbox</p>
                    </div>
                    <div class="ml-4 flex-shrink-0">
                        <button
                            type="button"
                            @onclick="ToggleCatchAll"
                            disabled="@_isSaving"
                            class="@GetToggleClasses() relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 disabled:opacity-50"
                            role="switch"
                            aria-checked="@_catchAllEnabled.ToString().ToLower()"
                            data-testid="catch-all-toggle">
                            <span class="@GetToggleKnobClasses() pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
                        </button>
                    </div>
                </div>

                <p class="mt-3 text-sm text-gray-500">
                    @if (_catchAllEnabled)
                    {
                        <span class="inline-flex items-center text-amber-700">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Catch-All Mode is enabled. View captured emails in <a href="/inbox/catch-all" class="underline font-medium">Catch-All Inbox</a>.
                        </span>
                    }
                    else
                    {
                        <span>Catch-All Mode is disabled. Only emails to registered domains will be accepted.</span>
                    }
                </p>
            </div>
        </div>

        <!-- Maintenance Mode Card -->
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm mb-6">
            <div class="px-6 py-5 border-b border-gray-200">
                <div class="flex items-center">
                    <div class="w-8 h-8 bg-red-100 rounded-md flex items-center justify-center mr-3">
                        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-lg font-medium text-gray-900">Maintenance Mode</h2>
                        <p class="text-sm text-gray-500">Re-enter the setup wizard to change core configuration</p>
                    </div>
                </div>
            </div>

            <div class="px-6 py-5">
                <div class="bg-red-50 border border-red-200 rounded-md p-4 mb-6">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.966-.833-2.736 0L3.077 16.5c-.77.833.192 2.5 1.732 2.5z" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-red-800">Warning</h3>
                            <p class="mt-1 text-sm text-red-700">
                                Enabling maintenance mode will immediately lock the application and sign all users out. A new setup password will be printed to the server logs. The app will be inaccessible until you complete the setup wizard.
                            </p>
                        </div>
                    </div>
                </div>

                <button
                    type="button"
                    @onclick="ShowMaintenanceConfirm"
                    disabled="@_isEnteringMaintenance"
                    class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Enter Maintenance Mode
                </button>
            </div>
        </div>

    </div>
</div>

<ConfirmModal
    IsVisible="@_showMaintenanceConfirm"
    OnClose="@(() => _showMaintenanceConfirm = false)"
    OnConfirm="@ConfirmMaintenanceMode"
    IsProcessing="@_isEnteringMaintenance"
    Title="Enter Maintenance Mode?"
    Variant="danger"
    ConfirmLabel="Enter Maintenance Mode"
    AriaLabelledBy="maintenance-mode-confirm-title">
    <p class="text-sm text-gray-700">The application will be locked immediately and all users will be signed out. A new setup password will appear in the server logs.</p>
    <p class="mt-2 text-sm font-medium text-gray-900">Are you sure you want to continue?</p>
</ConfirmModal>
