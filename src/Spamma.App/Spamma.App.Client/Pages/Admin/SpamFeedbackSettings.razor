@page "/admin/subdomains/{SubdomainId:guid}/spam-feedback"
@using Spamma.App.Client.Layout
@layout AppLayout
@attribute [Authorize]
<PageTitle>Spam Feedback - Spamma</PageTitle>

<AdminHeader Title="Spam Feedback" Subtitle="Configure complaint testing for this subdomain">
    <Controls>
        <a href="@($"/admin/subdomains/{SubdomainId}")"
           class="inline-flex items-center gap-1.5 p-2 text-sm text-gray-500 hover:text-gray-700 rounded-md hover:bg-gray-100">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Subdomain
        </a>
    </Controls>
</AdminHeader>

<div class="min-h-screen bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        @if (error is not null)
        {
            <div role="alert" class="mb-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">@error</div>
        }

        @if (loading)
        {
            <div class="flex items-center justify-center py-16">
                <svg class="animate-spin h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" aria-label="Loading feedback settings">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="sr-only">Loading feedback settings...</span>
            </div>
        }
        else if (canConfigure)
        {
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault class="space-y-6">
                <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
                    <div class="px-6 py-5 border-b border-gray-200">
                        <h2 class="text-lg font-medium text-gray-900">ARF email</h2>
                        <p class="mt-1 text-sm text-gray-500">Send a test abuse report to a complaint handler on the verified parent domain.</p>
                    </div>
                    <div class="px-6 py-5">
                        <label for="arf-recipient" class="block text-sm font-medium text-gray-700 mb-2">ARF email destination</label>
                        <input id="arf-recipient" type="email" @bind="arfRecipient"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                               placeholder="abuse@example.com" />
                        <p class="mt-2 text-xs text-gray-500">Leave this blank to disable ARF email for this subdomain.</p>
                    </div>
                </div>

                <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
                    <div class="px-6 py-5 border-b border-gray-200">
                        <h2 class="text-lg font-medium text-gray-900">Signed webhook</h2>
                        <p class="mt-1 text-sm text-gray-500">Send a test complaint event without involving a mailbox provider.</p>
                    </div>
                    <div class="px-6 py-5">
                        <label for="webhook-url" class="block text-sm font-medium text-gray-700 mb-2">Signed webhook URL</label>
                        <input id="webhook-url" type="url" @bind="webhookUrl"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                               placeholder="https://feedback.example.com/spam" />
                        <p class="mt-2 text-xs text-gray-500">Use a public HTTPS URL on the verified parent domain. Leave this blank to disable the webhook.</p>
                        @if (hasWebhookSecret && newWebhookSecret is null)
                        {
                            <p class="mt-3 text-sm text-gray-500">A webhook signing secret is configured. Changing the URL rotates it.</p>
                        }
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-4">
                    <button type="submit" disabled="@saving"
                            class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50">
                        @(saving ? "Saving..." : "Save feedback settings")
                    </button>
                    @if (saved)
                    {
                        <p role="status" class="text-sm font-medium text-green-700">Feedback settings saved.</p>
                    }
                </div>
            </form>

            @if (newWebhookSecret is not null)
            {
                <div role="status" class="mt-6 rounded-md border border-amber-200 bg-amber-50 p-4">
                    <h2 class="text-sm font-medium text-amber-800">Copy the webhook signing secret now</h2>
                    <p class="mt-1 text-sm text-amber-700">It will not be shown again.</p>
                    <code id="webhook-secret" class="mt-3 block break-all rounded-md border border-amber-200 bg-white p-3 text-sm text-gray-900">@newWebhookSecret</code>
                    <p class="mt-3 text-xs text-amber-800">Verify X-Spamma-Signature as HMAC-SHA256 over the X-Spamma-Timestamp, a period, and the exact request body.</p>
                </div>
            }
        }
    </div>
</div>
