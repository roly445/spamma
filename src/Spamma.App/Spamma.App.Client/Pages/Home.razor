@page "/m/inbox"
@page "/m/catch-all"
@page "/m/campaigns"
@page "/m/campaigns/{CampaignId:guid}"
@using Spamma.App.Client.Pages.Inbox
@layout AppLayout
@attribute [Authorize]

<PageTitle>@GetPageTitle()</PageTitle>

<div class="flex-1 flex overflow-hidden bg-gray-50">
    <div class="w-16 flex-shrink-0 bg-white border-r border-gray-200">
        <nav class="flex flex-col items-center gap-2 py-4" aria-label="Inbox tabs">
            <a href="/m/inbox"
               class="@GetTabClasses(InboxTab.Inbox)"
               aria-current="@(GetActiveTab() == InboxTab.Inbox ? "page" : null)"
               aria-label="Inbox"
               title="Inbox"
               @onclick="() => NavigateToTab(InboxTab.Inbox)"
               @onclick:preventDefault="true"
               data-testid="inbox-tab">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
            </a>
            <a href="/m/catch-all"
               class="@GetTabClasses(InboxTab.CatchAll)"
               aria-current="@(GetActiveTab() == InboxTab.CatchAll ? "page" : null)"
               aria-label="Catch-All"
               title="Catch-All"
               @onclick="() => NavigateToTab(InboxTab.CatchAll)"
               @onclick:preventDefault="true"
               data-testid="catch-all-tab">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                </svg>
            </a>
            <a href="/m/campaigns"
               class="@GetTabClasses(InboxTab.Campaigns)"
               aria-current="@(GetActiveTab() == InboxTab.Campaigns ? "page" : null)"
               aria-label="Campaigns"
               title="Campaigns"
               @onclick="() => NavigateToTab(InboxTab.Campaigns)"
               @onclick:preventDefault="true"
               data-testid="campaigns-tab">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
            </a>
        </nav>
    </div>

    @if (GetActiveTab() == InboxTab.CatchAll)
    {
        <CatchAllInbox />
    }
    else if (GetActiveTab() == InboxTab.Campaigns)
    {
        <div class="flex-1 flex overflow-hidden" data-testid="campaigns-home">
            <div class="w-96 flex-shrink-0 h-full">
                <div class="flex flex-col h-full bg-white border-r border-gray-200">
                    <div class="flex items-center justify-between p-4 border-b border-gray-200 flex-shrink-0">
                        <h2 class="text-lg font-semibold text-gray-800">Campaigns</h2>
                        <button class="p-1 text-gray-400 hover:text-gray-600"
                                title="Refresh campaigns"
                                @onclick="RefreshCampaigns"
                                disabled="@_campaignsLoading">
                            @if (_campaignsLoading)
                            {
                                <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-gray-600"></div>
                            }
                            else
                            {
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                </svg>
                            }
                        </button>
                    </div>

                    <div class="p-3 border-b border-gray-200 flex-shrink-0 space-y-3">
                        <div>
                            <label for="campaign-subdomain" class="block text-xs font-medium text-gray-600 mb-1">Subdomain</label>
                            <select id="campaign-subdomain"
                                    value="@_selectedSubdomainId"
                                    @onchange="OnCampaignSubdomainChanged"
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                <option value="">Select subdomain</option>
                                @if (_subdomains != null)
                                {
                                    @foreach (var subdomain in _subdomains)
                                    {
                                        <option value="@subdomain.Id">@subdomain.SubdomainName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <label for="campaign-sort" class="block text-xs font-medium text-gray-600 mb-1">Sort by</label>
                            <select id="campaign-sort"
                                    value="@_campaignSortBy"
                                    @onchange="OnCampaignSortChanged"
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                <option value="LastReceivedAt">Last received</option>
                                <option value="TotalCaptured">Total captured</option>
                                <option value="FirstReceivedAt">First received</option>
                                <option value="CampaignValue">Campaign name</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex-1 flex flex-col min-h-0">
                        <div class="flex-1 overflow-y-auto min-h-0">
                            @if (_campaignsLoading)
                            {
                                <div class="flex items-center justify-center p-8">
                                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                                </div>
                            }
                            else if (_campaigns != null && _campaigns.Items.Count == 0)
                            {
                                <div class="flex flex-col items-center justify-center p-8 text-center" data-testid="campaigns-empty-state">
                                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                                    </svg>
                                    <h3 class="mt-2 text-sm font-medium text-gray-900">No campaigns found</h3>
                                    <p class="mt-1 text-sm text-gray-500">Send emails with the x-spamma-camp header to get started.</p>
                                </div>
                            }
                            else if (_campaigns != null)
                            {
                                @foreach (var campaign in _campaigns.Items)
                                {
                                    <div class="@GetCampaignItemClasses(campaign)"
                                         @onclick="() => HandleCampaignSelected(campaign)"
                                         data-testid="campaign-row">
                                        <div class="flex items-start justify-between gap-3 p-4 text-left">
                                            <div class="min-w-0">
                                                <p class="text-sm font-medium text-gray-900 truncate">@campaign.CampaignValue</p>
                                                <p class="mt-1 text-xs text-gray-500">@campaign.TotalCaptured captured</p>
                                                <p class="mt-1 text-xs text-gray-500">Last: @campaign.LastReceivedAt.ToString("g")</p>
                                                <p class="mt-1 text-xs text-gray-500">First: @campaign.FirstReceivedAt.ToString("g")</p>
                                            </div>
                                            <span class="inline-flex h-6 min-w-6 items-center justify-center rounded bg-purple-100 px-2 text-xs font-medium text-purple-800">@campaign.TotalCaptured</span>
                                        </div>
                                        <div class="px-4 pb-3 text-left">
                                            <button @onclick="() => DeleteCampaign(campaign.CampaignId, campaign.CampaignValue)"
                                                    @onclick:stopPropagation="true"
                                                    disabled="@(_deletingCampaignValue != null && _deletingCampaignValue != campaign.CampaignValue)"
                                                    class="@GetDeleteCampaignClasses(campaign.CampaignValue)"
                                                    type="button">
                                                @if (_deletingCampaignValue == campaign.CampaignValue)
                                                {
                                                    <span>Deleting...</span>
                                                }
                                                else
                                                {
                                                    <span>Delete</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        @if (_campaigns != null && _campaigns.TotalPages > 1)
                        {
                            <div class="border-t border-gray-200 px-4 py-3 bg-gray-50 flex-shrink-0">
                                <div class="flex flex-col gap-3">
                                    <div class="text-sm text-gray-700">
                                        Showing @((_campaignCurrentPage - 1) * _campaignPageSize + 1) to
                                        @Math.Min(_campaignCurrentPage * _campaignPageSize, _campaigns.TotalCount) of
                                        @_campaigns.TotalCount campaigns
                                    </div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <button class="relative inline-flex items-center justify-center px-2 py-1 border border-gray-300 text-sm font-medium rounded-md text-gray-500 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
                                                title="Previous page"
                                                @onclick="PreviousCampaignPage"
                                                disabled="@(!_campaigns.HasPreviousPage || _campaignsLoading)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                                            </svg>
                                        </button>
                                        @foreach (var pageNumber in GetVisibleCampaignPageNumbers())
                                        {
                                            @if (pageNumber == _campaigns.Page)
                                            {
                                                <span class="relative inline-flex items-center px-3 py-1 border border-blue-500 text-sm font-medium rounded-md text-blue-600 bg-blue-50">@pageNumber</span>
                                            }
                                            else
                                            {
                                                <button class="relative inline-flex items-center px-3 py-1 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50"
                                                        @onclick="() => GoToCampaignPage(pageNumber)"
                                                        disabled="@_campaignsLoading">
                                                    @pageNumber
                                                </button>
                                            }
                                        }
                                        <button class="relative inline-flex items-center justify-center px-2 py-1 border border-gray-300 text-sm font-medium rounded-md text-gray-500 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
                                                title="Next page"
                                                @onclick="NextCampaignPage"
                                                disabled="@(!_campaigns.HasNextPage || _campaignsLoading)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="flex-1 min-w-0">
                @if (_campaignDetailLoading)
                {
                    <div class="flex h-full items-center justify-center bg-white">
                        <div class="text-center">
                            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">Loading campaign...</h3>
                        </div>
                    </div>
                }
                else if (_campaignDetail == null)
                {
                    <div class="flex h-full items-center justify-center bg-white" data-testid="campaign-detail-empty">
                        <div class="text-center">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">No campaign selected</h3>
                            <p class="mt-1 text-sm text-gray-500">Choose a campaign from the list to view details.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex h-full flex-col bg-white" data-testid="campaign-detail">
                        <div class="border-b border-gray-200 p-6 flex-shrink-0">
                            <h1 class="text-xl font-semibold text-gray-900">@_campaignDetail.CampaignValue</h1>
                            <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
                                <div class="rounded-md border border-gray-200 p-4">
                                    <p class="text-sm text-gray-500">Total captured</p>
                                    <p class="mt-1 text-2xl font-bold text-gray-900">@_campaignDetail.TotalCaptured</p>
                                </div>
                                <div class="rounded-md border border-gray-200 p-4">
                                    <p class="text-sm text-gray-500">First received</p>
                                    <p class="mt-1 text-sm font-mono text-gray-700">@_campaignDetail.FirstReceivedAt.ToString("g")</p>
                                </div>
                                <div class="rounded-md border border-gray-200 p-4">
                                    <p class="text-sm text-gray-500">Last received</p>
                                    <p class="mt-1 text-sm font-mono text-gray-700">@_campaignDetail.LastReceivedAt.ToString("g")</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex-1 min-h-0">
                            @if (_campaignEmailSummary != null)
                            {
                                <EmailViewer Email="@_campaignEmailSummary" HideCampaignInfo="true" HideMessageActions="true" />
                            }
                            else
                            {
                                <div class="flex h-full items-center justify-center">
                                    <p class="text-sm text-gray-500">No sample message available.</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="flex-1 flex overflow-hidden">
            <div class="w-96 flex-shrink-0 h-full">
                <div class="flex flex-col h-full bg-white border-r border-gray-200">
                    <div class="flex items-center justify-between p-4 border-b border-gray-200 flex-shrink-0">
                        <h2 class="text-lg font-semibold text-gray-800">Inbox</h2>
                        <div class="flex items-center space-x-2">
                            <button class="p-1 text-gray-400 hover:text-gray-600" @onclick="RefreshEmails" disabled="@_isLoading">
                                @if (_isLoading)
                                {
                                    <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-gray-600"></div>
                                }
                                else
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                </svg>
                            }
                        </button>
                        </div>
                    </div>

                    <div class="p-3 border-b border-gray-200 flex-shrink-0">
                        <div class="relative">
                            <input type="text"
                                   placeholder="Search emails..."
                                   class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                   @bind="_searchText"
                                   @bind:event="oninput"
                                   @onkeypress="HandleSearchKeyPress">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_searchText))
                            {
                                <button class="absolute inset-y-0 right-0 pr-3 flex items-center"
                                        @onclick="ClearSearch">
                                    <svg class="h-5 w-5 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            }
                        </div>

                        <div class="mt-2 flex items-center">
                            <label class="flex items-center cursor-pointer text-sm text-gray-700 hover:text-gray-900">
                                <input type="checkbox"
                                       class="rounded border-gray-300 text-purple-600 focus:ring-purple-500"
                                       checked="@_showCampaignEmails"
                                       @onchange="ToggleCampaignFilter">
                                <span class="ml-2">Show campaign emails</span>
                            </label>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_searchText) || _searchResult != null)
                        {
                            <div class="mt-2 text-xs text-gray-500">
                                @if (_isSearching)
                                {
                                    <span>Searching...</span>
                                }
                                else if (_searchResult != null)
                                {
                                    <span>@_searchResult.TotalCount result@(_searchResult.TotalCount != 1 ? "s" : "")</span>
                                    @if (!string.IsNullOrWhiteSpace(_searchText))
                                    {
                                        <span> for "@_searchText"</span>
                                    }
                                    @if (_searchResult.TotalPages > 1)
                                    {
                                        <span> - Page @_searchResult.Page of @_searchResult.TotalPages</span>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <div class="flex-1 flex flex-col min-h-0">
                        <div class="flex-1 overflow-y-auto min-h-0">
                            @if (_isSearching)
                            {
                                <div class="flex items-center justify-center p-8">
                                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                                </div>
                            }
                            else if (emails.Count == 0 && !string.IsNullOrWhiteSpace(_searchText))
                            {
                                <div class="flex flex-col items-center justify-center p-8 text-center">
                                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                    </svg>
                                    <h3 class="mt-2 text-sm font-medium text-gray-900">No emails found</h3>
                                    <p class="mt-1 text-sm text-gray-500">Try adjusting your search terms.</p>
                                </div>
                            }
                            else if (emails.Count == 0)
                            {
                                <div class="flex flex-col items-center justify-center p-8 text-center">
                                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                    </svg>
                                    <h3 class="mt-2 text-sm font-medium text-gray-900">No emails</h3>
                                    <p class="mt-1 text-sm text-gray-500">Your inbox is empty.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var email in emails)
                                {
                                    <div class="@GetEmailItemClasses(email)" @onclick="() => HandleEmailSelected(email)">
                                        <div class="flex items-start space-x-3 p-4">
                                            <div class="flex-shrink-0">
                                                <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
                                                    <span class="text-sm font-medium text-white">@email.PrimaryToAddress.Substring(0, 1).ToUpper()</span>
                                                </div>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="flex items-center justify-between">
                                                    <p class="text-sm font-medium text-gray-900 truncate">@email.PrimaryToAddress</p>
                                                    <div class="flex items-center space-x-1">
                                                        @if (email.IsFavorite)
                                                        {
                                                            <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 24 24">
                                                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                                            </svg>
                                                        }
                                                        <p class="text-xs text-gray-500">@email.ReceivedAt</p>
                                                    </div>
                                                </div>
                                                <p class="text-sm text-gray-900 font-medium truncate mt-1">@HighlightSearchTerm(email.Subject, _searchText)</p>
                                                @if (email.CampaignId.HasValue)
                                                {
                                                    <div class="mt-1.5">
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800" title="Campaign: @email.CampaignValue">
                                                            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                                                <path d="M2 6a2 2 0 012-2h12a2 2 0 012 2v2a2 2 0 100 4v2a2 2 0 01-2 2H4a2 2 0 01-2-2v-2a2 2 0 100-4V6z" />
                                                            </svg>
                                                            @if (!string.IsNullOrEmpty(email.CampaignValue))
                                                            {
                                                                <span class="truncate max-w-[150px]">@email.CampaignValue</span>
                                                            }
                                                            else
                                                            {
                                                                <span>Campaign</span>
                                                            }
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        @if (_searchResult != null && _searchResult.TotalPages > 1)
                        {
                            <div class="border-t border-gray-200 px-4 py-3 bg-gray-50 flex-shrink-0 overflow-x-auto">
                                <div class="flex flex-col gap-3">
                                    <div class="flex items-center text-sm text-gray-700">
                                        <span>
                                            Showing @((_searchResult.Page - 1) * _searchResult.PageSize + 1) to
                                            @Math.Min(_searchResult.Page * _searchResult.PageSize, _searchResult.TotalCount) of
                                            @_searchResult.TotalCount emails
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <button class="relative inline-flex items-center justify-center px-2 py-1 border border-gray-300 text-sm font-medium rounded-md text-gray-500 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap"
                                                title="Previous page"
                                                @onclick="() => GoToEmailPage(_searchResult.Page - 1)"
                                                disabled="@(_searchResult.Page <= 1 || _isLoading)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                                            </svg>
                                        </button>

                                        @foreach (var pageNumber in GetVisiblePageNumbers())
                                        {
                                            @if (pageNumber == _searchResult.Page)
                                            {
                                                <span class="relative inline-flex items-center px-3 py-1 border border-blue-500 text-sm font-medium rounded-md text-blue-600 bg-blue-50 whitespace-nowrap">
                                                    @pageNumber
                                                </span>
                                            }
                                            else
                                            {
                                                <button class="relative inline-flex items-center px-3 py-1 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 whitespace-nowrap"
                                                        @onclick="() => GoToEmailPage(pageNumber)"
                                                        disabled="@_isLoading">
                                                    @pageNumber
                                                </button>
                                            }
                                        }

                                        <button class="relative inline-flex items-center justify-center px-2 py-1 border border-gray-300 text-sm font-medium rounded-md text-gray-500 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap"
                                                title="Next page"
                                                @onclick="() => GoToEmailPage(_searchResult.Page + 1)"
                                                disabled="@(_searchResult.Page >= _searchResult.TotalPages || _isLoading)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="flex-1">
                <EmailViewer Email="@selectedEmail" OnEmailDeleted="HandleEmailDeleted" OnEmailUpdated="HandleEmailUpdated" />
            </div>
        </div>
    }
</div>
