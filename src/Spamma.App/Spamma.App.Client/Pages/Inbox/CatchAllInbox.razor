<div class="flex-1 flex overflow-hidden bg-gray-50" data-testid="catch-all-inbox">
    @if (!_catchAllEnabled)
    {
        <div class="flex flex-1 flex-col items-center justify-center p-16 text-center" data-testid="disabled-state">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                </svg>
            </div>
            <h2 class="text-xl font-semibold text-gray-900 mb-2">Catch-All Mode is disabled</h2>
            <p class="text-gray-500 mb-6 max-w-md">Enable Catch-All Mode in Settings to capture emails sent to any address on this server, regardless of domain registration.</p>
            <a href="/admin/settings" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                Go to Settings
            </a>
        </div>
    }
    else
    {
        <!-- Main Content Area -->
        <div class="flex-1 flex overflow-hidden">
            <!-- Left Sidebar - Email List -->
            <div class="w-96 flex-shrink-0 h-full">
                <div class="flex flex-col h-full bg-white border-r border-gray-200">
                    <!-- Header -->
                    <div class="flex items-center justify-between p-4 border-b border-gray-200 flex-shrink-0">
                        <div class="flex items-center space-x-3">
                            <div class="flex items-center space-x-2">
                                <div class="w-2.5 h-2.5 rounded-full bg-blue-500"></div>
                                <h2 class="text-lg font-semibold text-gray-800">Catch-All Inbox</h2>
                            </div>
                        </div>
                        <button class="p-1 text-gray-400 hover:text-gray-600" @onclick="LoadEmails" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-gray-600"></div>
                            }
                            else
                            {
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                            }
                        </button>
                    </div>

                    <!-- Search Bar -->
                    <div class="p-3 border-b border-gray-200 flex-shrink-0">
                        <div class="relative">
                            <input type="text"
                                   placeholder="Search catch-all emails..."
                                   class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                   @bind="_searchText"
                                   @bind:event="oninput"
                                   @onkeypress="HandleSearchKeyPress">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_searchText))
                            {
                                <button class="absolute inset-y-0 right-0 pr-3 flex items-center"
                                        @onclick="ClearSearch">
                                    <svg class="h-5 w-5 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            }
                        </div>

                        @if (_isSearching || !string.IsNullOrWhiteSpace(_searchText) || _totalCount > 0)
                        {
                            <div class="mt-2 text-xs text-gray-500">
                                @if (_isSearching)
                                {
                                    <span>Searching...</span>
                                }
                                else
                                {
                                    <span>@_totalCount result@(_totalCount != 1 ? "s" : "")</span>
                                    @if (!string.IsNullOrWhiteSpace(_searchText))
                                    {
                                        <span> for "@_searchText"</span>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <!-- Email Groups -->
                    <div class="flex-1 overflow-y-auto min-h-0">
                        @if (_isLoading || _isSearching)
                        {
                            <div class="flex items-center justify-center p-8">
                                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                            </div>
                        }
                        else if (_groups.Count == 0 && !string.IsNullOrWhiteSpace(_searchText))
                        {
                            <div class="flex flex-col items-center justify-center p-8 text-center" data-testid="empty-state">
                                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                                <h3 class="mt-2 text-sm font-medium text-gray-900">No catch-all emails found</h3>
                                <p class="mt-1 text-sm text-gray-500">Try adjusting your search terms.</p>
                            </div>
                        }
                        else if (_groups.Count == 0)
                        {
                            <div class="flex flex-col items-center justify-center p-8 text-center" data-testid="empty-state">
                                <svg class="mx-auto h-12 w-12 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                                </svg>
                                <h3 class="mt-2 text-sm font-medium text-gray-900">No catch-all emails yet</h3>
                                <p class="mt-1 text-sm text-gray-500">Send an email to any address on this server.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var group in _groups)
                            {
                                <div class="border-b border-gray-100" data-testid="domain-group">
                                    <!-- Domain Header -->
                                    <div class="px-4 py-2 bg-gray-50 border-b border-gray-200 flex items-center justify-between sticky top-0">
                                        <div class="flex items-center space-x-2">
                                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                            </svg>
                                            <span class="text-xs font-semibold text-gray-700">From: @group.SenderAddress</span>
                                        </div>
                                        <span class="text-xs text-gray-600 bg-white border border-gray-200 rounded-full px-2 py-0.5">@group.Emails.Count</span>
                                    </div>

                                    <!-- Emails in group -->
                                    @foreach (var email in group.Emails)
                                    {
                                        <div class="@GetEmailItemClasses(email)" @onclick="() => HandleEmailSelected(email)" data-testid="catch-all-email-row">
                                            <div class="flex items-start space-x-3 p-4">
                                                <div class="flex-shrink-0">
                                                    <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
                                                        <span class="text-sm font-medium text-white">@email.PrimaryToAddress.Substring(0, 1).ToUpper()</span>
                                                    </div>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-center justify-between">
                                                        <p class="text-sm font-medium text-gray-900 truncate">@email.PrimaryToAddress</p>
                                                        <p class="text-xs text-gray-500 ml-2 flex-shrink-0">@email.ReceivedAt.ToString("MMM d")</p>
                                                    </div>
                                                    <p class="text-sm text-gray-600 truncate mt-0.5">@email.Subject</p>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Right Content - Email Viewer -->
            <div class="flex-1 min-w-0 h-full bg-white">
                @if (_selectedEmail != null)
                {
                    <EmailViewer Email="@_selectedEmail" OnEmailDeleted="HandleEmailDeleted" OnEmailUpdated="HandleEmailUpdated" />
                }
                else
                {
                    <div class="flex flex-col items-center justify-center h-full bg-white text-center p-8">
                        <svg class="mx-auto h-16 w-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">No email selected</h3>
                        <p class="mt-1 text-sm text-gray-500">Choose an email from the list to view its contents.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>
