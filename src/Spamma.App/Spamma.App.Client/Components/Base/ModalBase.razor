@namespace Spamma.App.Client.Components.Base

@if (IsVisible)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="@AriaLabelledBy" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-black/60 transition-opacity backdrop-blur-sm" aria-hidden="true"></div>
        <div class="relative flex min-h-screen items-center justify-center p-4" @onclick="HandleBackdropClick">
            <div class="w-full bg-white rounded-lg text-left shadow-xl @WidthClass" @onclick:stopPropagation="true">
                @ChildContent
            </div>
        </div>
    </div>
}
