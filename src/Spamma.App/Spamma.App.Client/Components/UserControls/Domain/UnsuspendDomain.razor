@if (isVisible && _dataModel != null)
{
    <ConfirmModal IsVisible="true"
                  OnClose="Close"
                  OnConfirm="HandleUnsuspendDomain"
                  AllowBackdropClose="true"
                  WidthClass="sm:max-w-md"
                  AriaLabelledBy="unsuspend-domain-title"
                  Title="Unsuspend Domain"
                  Subtitle="@_dataModel.DomainName"
                  Message="Restore domain management and related workflows?"
                  Variant="success"
                  IsProcessing="@isProcessing"
                  ConfirmLabel="Unsuspend Domain" />
}
