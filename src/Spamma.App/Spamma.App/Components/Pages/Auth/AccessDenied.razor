@page "/access-denied"
@using Microsoft.AspNetCore.Authorization
@inject IHttpContextAccessor HttpContextAccessor
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Access denied | Spamma</PageTitle>

<div class="min-h-screen flex flex-col bg-gradient-to-br from-blue-50 via-white to-indigo-50 text-gray-900">
    <header class="border-b border-gray-200 bg-white/80">
        <div class="mx-auto flex max-w-6xl items-center px-4 py-5 sm:px-6">
            <a href="/m/inbox" class="inline-flex items-center gap-3 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2" aria-label="Spamma inbox">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-600 text-white" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 002 2v10a2 2 0 002 2z" />
                    </svg>
                </span>
                <span class="text-xl font-bold">Spamma</span>
            </a>
        </div>
    </header>

    <main class="flex flex-1 items-center justify-center px-4 py-12 sm:px-6" id="main-content">
        <section class="w-full max-w-xl rounded-2xl border border-gray-200 bg-white p-6 shadow-xl sm:p-10" aria-labelledby="access-denied-heading">
            <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 text-blue-700" aria-hidden="true">
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>

            <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-700">Permission required</p>
            <h1 id="access-denied-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Access denied</h1>
            <p class="mt-4 text-base leading-7 text-gray-700">
                Your account does not have permission to view this page.
            </p>
            <p class="mt-3 text-sm leading-6 text-gray-600">
                If you need access, contact your Spamma administrator.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a href="/m/inbox" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2">
                    Return to inbox
                </a>
                <a href="@GetBackUrl()" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-800 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2">
                    Go back
                </a>
            </div>
        </section>
    </main>
</div>

@code {
    private string GetBackUrl()
    {
        var request = HttpContextAccessor.HttpContext?.Request;
        if (request is null ||
            !Uri.TryCreate(request.Headers["Referer"].ToString(), UriKind.Absolute, out var previous) ||
            !previous.AbsolutePath.StartsWith("/m/", StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(previous.GetLeftPart(UriPartial.Authority),
                $"{request.Scheme}://{request.Host}", StringComparison.OrdinalIgnoreCase))
        {
            return "/m/inbox";
        }

        return previous.PathAndQuery + previous.Fragment;
    }
}
